<%@ Page Language="C#" AutoEventWireup="true" MasterPageFile="~/Sitio.Master" CodeBehind="Login.aspx.cs" Inherits="CooperativaCarchi.Login" %>
<asp:Content ID="Principal" ContentPlaceHolderID="Contenido" runat="server"><h1>Acceder al sistema</h1><asp:Label ID="Mensaje" runat="server" role="status" CssClass="mensaje"/><section><div class="fields"><div class="field"><asp:Label runat="server" AssociatedControlID="UsuarioNombre" Text="Usuario"/><asp:TextBox ID="UsuarioNombre" runat="server" MaxLength="250"/></div><div class="field"><asp:Label runat="server" AssociatedControlID="Clave" Text="Contraseña"/><asp:TextBox ID="Clave" runat="server" MaxLength="250" TextMode="Password"/></div><div class="field"><asp:Label runat="server" AssociatedControlID="Mostrar" Text="Mostrar contraseña"/><asp:CheckBox ID="Mostrar" runat="server" Checked="true"/></div></div><div class="actions"><asp:Button ID="Entrar" runat="server" Text="Iniciar sesión" OnClick="IniciarSesion"/><a class="boton" href="Registro.aspx">Registrarse / Configuración inicial</a></div></section><p class="nota">La primera cuenta administradora se crea desde localhost. Los registros públicos posteriores reciben el rol Usuario.</p><script>document.getElementById('<%= Mostrar.ClientID %>').checked=false;document.getElementById('<%= Mostrar.ClientID %>').addEventListener('change',function(){document.getElementById('<%= Clave.ClientID %>').type=this.checked?'text':'password';});</script></asp:Content>