<%@ Page Language="C#" AutoEventWireup="true" MasterPageFile="~/Sitio.Master" CodeBehind="Transacciones.aspx.cs" Inherits="CooperativaCarchi.Transacciones" ResponseEncoding="utf-8" %>
<asp:Content ID="Principal" ContentPlaceHolderID="Contenido" runat="server"><h1>Transacciones</h1><asp:Label ID="Mensaje" runat="server" CssClass="mensaje" role="status"/><p>Guarda y revisa el borrador antes de confirmar. Si cambias algún campo, pulsa Actualizar borrador antes de confirmar. Los asientos confirmados se conservan sin edición ni eliminación.</p><section><div class="fields"><div class="field"><asp:Label runat="server" AssociatedControlID="EmpresaLista" Text="Empresa"/><asp:DropDownList ID="EmpresaLista" runat="server" AutoPostBack="true" OnSelectedIndexChanged="CambiarEmpresa"></asp:DropDownList></div><div class="field"><asp:Label runat="server" AssociatedControlID="IdRegistro" Text="ID"/><asp:TextBox ID="IdRegistro" runat="server" ReadOnly="true"/></div><div class="field"><asp:Label runat="server" AssociatedControlID="FechaOperacion" Text="Fecha"/><asp:TextBox ID="FechaOperacion" runat="server" TextMode="Date"/></div><div class="field"><asp:Label runat="server" AssociatedControlID="Glosa" Text="Glosa"/><asp:TextBox ID="Glosa" runat="server" MaxLength="250"/></div><div class="field"><asp:Label runat="server" AssociatedControlID="Tipo" Text="Tipo"/><asp:DropDownList ID="Tipo" runat="server"><asp:ListItem Value="Manual">Manual</asp:ListItem><asp:ListItem Value="Compra">Compra</asp:ListItem><asp:ListItem Value="Venta">Venta</asp:ListItem></asp:DropDownList></div><div class="field"><asp:Label runat="server" AssociatedControlID="Tratamiento" Text="Tratamiento IVA"/><asp:DropDownList ID="Tratamiento" runat="server"><asp:ListItem Value="Gravado">Gravado</asp:ListItem><asp:ListItem Value="TarifaCero">TarifaCero</asp:ListItem><asp:ListItem Value="NoObjeto">NoObjeto</asp:ListItem><asp:ListItem Value="Exento">Exento</asp:ListItem></asp:DropDownList></div><div class="field"><asp:Label runat="server" AssociatedControlID="Subtotal" Text="Subtotal (compra o venta)"/><asp:TextBox ID="Subtotal" runat="server"/></div><div class="field"><asp:Label runat="server" AssociatedControlID="CuentaBase" Text="Cuenta base (compra o venta)"/><asp:DropDownList ID="CuentaBase" runat="server"></asp:DropDownList></div><div class="field"><asp:Label runat="server" AssociatedControlID="CuentaIVA" Text="Cuenta IVA (si corresponde)"/><asp:DropDownList ID="CuentaIVA" runat="server"></asp:DropDownList></div><div class="field"><asp:Label runat="server" AssociatedControlID="Contrapartida" Text="Contrapartida (caja, bancos, cliente o proveedor)"/><asp:DropDownList ID="Contrapartida" runat="server"></asp:DropDownList></div></div><p class="nota">Compra y Venta generan las líneas del asiento al guardar. Una compra de inventario registra la adquisición; las salidas y el costo de ventas se registran mediante asiento manual hasta incorporar Kárdex. Manual utiliza las líneas ingresadas a continuación y no calcula IVA automáticamente.</p><h2>Líneas para asiento manual</h2><div class="fields"><div class="field"><asp:Label runat="server" AssociatedControlID="CuentaLinea" Text="Cuenta"/><asp:DropDownList ID="CuentaLinea" runat="server"/></div><div class="field"><asp:Label runat="server" AssociatedControlID="Debe" Text="Debe"/><asp:TextBox ID="Debe" runat="server"/></div><div class="field"><asp:Label runat="server" AssociatedControlID="Haber" Text="Haber"/><asp:TextBox ID="Haber" runat="server"/></div></div><div class="actions"><asp:Button ID="Agregar" runat="server" Text="Agregar línea" OnClick="AgregarLinea"/></div><div class="tabla-wrap"><asp:GridView ID="Lineas" runat="server" AutoGenerateColumns="false" OnRowDeleting="QuitarLinea" CssClass="tabla" GridLines="None"><Columns><asp:BoundField DataField="Codigo" HeaderText="Código"/><asp:BoundField DataField="Nombre" HeaderText="Cuenta"/><asp:BoundField DataField="Debe" HeaderText="Debe" DataFormatString="{0:N2}"/><asp:BoundField DataField="Haber" HeaderText="Haber" DataFormatString="{0:N2}"/><asp:CommandField ShowDeleteButton="true" DeleteText="Quitar"/></Columns></asp:GridView></div><asp:Label ID="Resumen" runat="server"/><div class="actions"><asp:Button ID="Nuevo" runat="server" Text="Nuevo" OnClick="Limpiar"/><asp:Button ID="Guardar" runat="server" Text="Guardar borrador" OnClick="GuardarRegistro"/><asp:Button ID="Actualizar" runat="server" Text="Actualizar borrador" OnClick="ActualizarRegistro"/><asp:Button ID="Eliminar" runat="server" Text="Eliminar borrador" OnClick="EliminarRegistro" OnClientClick="return confirm('¿Confirmar el borrador guardado? Actualice primero si modificó los campos.');"/><asp:Button ID="Confirmar" runat="server" Text="Confirmar borrador guardado" OnClick="ConfirmarRegistro" OnClientClick="return confirm('¿Confirmar el borrador guardado? Actualice primero si modificó los campos.');"/></div></section><section><h2>Registros de la empresa</h2><div class="tabla-wrap"><asp:GridView ID="Tabla" runat="server" AutoGenerateColumns="false" DataKeyNames="Id" OnSelectedIndexChanged="SeleccionarRegistro" CssClass="tabla" GridLines="None" EmptyDataText="No hay transacciones."><Columns><asp:CommandField ShowSelectButton="true" SelectText="Seleccionar"/><asp:BoundField DataField="Id" HeaderText="ID"/><asp:BoundField DataField="Fecha" HeaderText="Fecha" DataFormatString="{0:yyyy-MM-dd}"/><asp:BoundField DataField="Glosa" HeaderText="Glosa"/><asp:BoundField DataField="Tipo" HeaderText="Tipo"/><asp:BoundField DataField="Estado" HeaderText="Estado"/><asp:BoundField DataField="PorcentajeAplicado" HeaderText="IVA %" DataFormatString="{0:0.####}"/><asp:BoundField DataField="IVA" HeaderText="IVA" DataFormatString="{0:N2}"/><asp:BoundField DataField="Total" HeaderText="Total" DataFormatString="{0:N2}"/></Columns></asp:GridView></div></section></asp:Content>