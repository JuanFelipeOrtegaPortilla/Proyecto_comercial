<%@ Control Language="C#" AutoEventWireup="true" CodeBehind="PanelModulos.ascx.cs" Inherits="CooperativaCarchi.PanelModulos" %>
<h1>Módulos del sistema</h1><p>Gestiona la información de Carchi y accede a las etapas del ciclo contable.</p>
<div class="tiles accesos"><section><h2>Empresas</h2><p>Información empresarial y configuración dinámica del IVA.</p><a class="boton" href="Empresa.aspx">Abrir empresas e IVA</a></section><section><h2>Plan de cuentas</h2><p>Catálogo, jerarquía y saldos iniciales por empresa.</p><a class="boton" href="PlanCuentas.aspx">Abrir plan de cuentas</a></section><% if (EsAdministrador) { %><section><h2>Usuarios</h2><p>Administración de usuarios, estados y permisos.</p><a class="boton" href="Registro.aspx">Administrar usuarios</a></section><% } %></div>
<section class="catalogo-modulos"><h2>Ciclo contable</h2><p>Las opciones disponibles abren su formulario. Las etapas pendientes muestran las funciones previstas.</p>
<div class="toolbar-modulos"><label for="buscar">Buscar módulo</label><input id="buscar" type="search" placeholder="Nombre del módulo" autocomplete="off"/><p id="contador" role="status"><%: Total %> módulos</p></div>
<div class="chips" role="group" aria-label="Filtrar módulos"><button type="button" class="chip is-active" data-filter="todos" aria-pressed="true">Todos</button><% foreach (var grupo in Grupos) { %><button type="button" class="chip" data-filter="<%: grupo.Id %>" aria-pressed="false"><%: grupo.Titulo %></button><% } %></div>
<% foreach (var grupo in Grupos) { %><section class="group" aria-labelledby="grupo-<%: grupo.Id %>"><h2 id="grupo-<%: grupo.Id %>"><%: grupo.Titulo %></h2><div class="tiles"><% foreach(var modulo in grupo.Modulos) { %><article class="modulo-tarjeta" data-group="<%: grupo.Id %>" data-texto="<%: modulo.Titulo %> <%: modulo.Resumen %>"><span class="estado-modulo"><%: CooperativaCarchi.ModulosCatalogo.Disponible(modulo.Id) ? "Disponible" : "Pendiente de implementación" %></span><h3><%: modulo.Titulo %></h3><p><%: CooperativaCarchi.ModulosCatalogo.Disponible(modulo.Id) ? ResumenDisponible(modulo.Id) : modulo.Resumen %></p><a href="<%: CooperativaCarchi.ModulosCatalogo.Ruta(modulo.Id) %>"><%: CooperativaCarchi.ModulosCatalogo.Disponible(modulo.Id) ? "Abrir módulo" : "Consultar funciones previstas" %></a></article><% } %></div></section><% } %>
<p id="sin-resultados" role="status" hidden="hidden">No hay módulos que coincidan con la búsqueda.</p></section><script src="menu.js"></script>
