<%@ Page Language="C#" AutoEventWireup="true" MasterPageFile="~/Sitio.Master" CodeBehind="Registro.aspx.cs" Inherits="CooperativaCarchi.Registro" %>
<asp:Content ID="Principal" ContentPlaceHolderID="Contenido" runat="server"><h1>Gestión de usuarios</h1><asp:Label ID="Mensaje" runat="server" role="status" CssClass="mensaje"/><section><div class="fields"><div class="field"><asp:Label runat="server" AssociatedControlID="IdRegistro" Text="ID"/><asp:TextBox ID="IdRegistro" runat="server" MaxLength="250" ReadOnly="true"/></div><div class="field"><asp:Label runat="server" AssociatedControlID="Nombres" Text="Nombres"/><asp:TextBox ID="Nombres" runat="server" MaxLength="250"/></div><div class="field"><asp:Label runat="server" AssociatedControlID="Apellidos" Text="Apellidos"/><asp:TextBox ID="Apellidos" runat="server" MaxLength="250"/></div><div class="field"><asp:Label runat="server" AssociatedControlID="UsuarioNombre" Text="Usuario"/><asp:TextBox ID="UsuarioNombre" runat="server" MaxLength="250"/></div><div class="field"><asp:Label runat="server" AssociatedControlID="Correo" Text="Correo electrónico"/><asp:TextBox ID="Correo" runat="server" MaxLength="250" TextMode="Email"/></div><div class="field"><asp:Label runat="server" AssociatedControlID="Clave" Text="Contraseña (vacía al editar: conservar)"/><asp:TextBox ID="Clave" runat="server" MaxLength="128" TextMode="Password"/></div><div class="field"><asp:Label runat="server" AssociatedControlID="Confirmacion" Text="Confirmar contraseña"/><asp:TextBox ID="Confirmacion" runat="server" MaxLength="128" TextMode="Password"/></div><div class="field"><asp:Label runat="server" AssociatedControlID="RolUsuario" Text="Rol"/><asp:DropDownList ID="RolUsuario" runat="server"><asp:ListItem Value="Usuario">Usuario</asp:ListItem><asp:ListItem Value="Administrador">Administrador</asp:ListItem></asp:DropDownList></div><div class="field"><asp:Label runat="server" AssociatedControlID="Activo" Text="Activo"/><asp:CheckBox ID="Activo" runat="server" Checked="true"/></div></div><div class="actions"><asp:Button ID="Nuevo" runat="server" Text="Nuevo" OnClick="Limpiar"/><asp:Button ID="Guardar" runat="server" Text="Guardar" OnClick="GuardarRegistro"/><asp:Button ID="Actualizar" runat="server" Text="Actualizar" OnClick="ActualizarRegistro"/><asp:Button ID="Eliminar" runat="server" Text="Eliminar" OnClick="EliminarRegistro" OnClientClick="return confirm('¿Eliminar el registro seleccionado?');" CssClass="danger"/><asp:Button ID="LimpiarBoton" runat="server" Text="Limpiar" OnClick="Limpiar"/></div></section><p><a href="Login.aspx">Volver al acceso</a></p><p class="nota">Registro público: rol Usuario. La primera cuenta administradora se configura desde localhost. Contraseñas de 10 a 128 caracteres.</p><section><div class="actions"><asp:TextBox ID="Buscar" runat="server" placeholder="Buscar" aria-label="Buscar registros"/><asp:Button ID="BuscarBoton" runat="server" Text="Buscar" OnClick="BuscarRegistros"/></div><div class="tabla-wrap"><asp:GridView ID="Tabla" runat="server" AutoGenerateColumns="false" DataKeyNames="Id" OnSelectedIndexChanged="SeleccionarRegistro" CssClass="tabla" GridLines="None" EmptyDataText="No hay registros."><Columns><asp:CommandField ShowSelectButton="true" SelectText="Seleccionar"/><asp:BoundField DataField="Id" HeaderText="ID"/><asp:BoundField DataField="Nombres" HeaderText="Nombres"/><asp:BoundField DataField="Apellidos" HeaderText="Apellidos"/><asp:BoundField DataField="NombreUsuario" HeaderText="Usuario"/><asp:BoundField DataField="Correo" HeaderText="Correo"/><asp:BoundField DataField="Rol" HeaderText="Rol"/><asp:BoundField DataField="Activo" HeaderText="Activo"/></Columns></asp:GridView></div></section></asp:Content>
