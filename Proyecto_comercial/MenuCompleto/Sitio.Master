<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Sitio.Master.cs" Inherits="CooperativaCarchi.Sitio" %>
<!DOCTYPE html><html lang="es"><head runat="server"><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Sistema contable Carchi</title><link href="bootstrap.min.css" rel="stylesheet"/><link href="sistema.css" rel="stylesheet"/></head><body class="<%= Page is CooperativaCarchi.Login ? "acceso" : "administracion" %>"><form id="form1" runat="server"><div class="shell"><aside><strong>Carchi<br/>Sistema contable</strong><a href="Inicio.aspx">Módulos del sistema</a><% if (EsAdministrador) { %><a href="Registro.aspx">Gestión de usuarios</a><% } else { %><a href="Registro.aspx">Registro</a><% } %><a href="Empresa.aspx">Empresas e IVA</a><a href="PlanCuentas.aspx">Plan de cuentas</a><a href="Transacciones.aspx">Transacciones</a><a href="LibroDiario.aspx">Libro Diario</a><a href="LibroMayor.aspx">Libro Mayor</a><asp:Button ID="Salir" runat="server" Text="Cerrar sesión" CssClass="logout" OnClick="CerrarSesion" CausesValidation="false"/></aside><main><header><span>Sistema contable | USD</span><span><asp:Literal ID="Identidad" runat="server" Mode="Encode"/></span></header><asp:ContentPlaceHolder ID="Contenido" runat="server"/><p class="nota"><%: ModoAlmacenamiento %></p></main></div></form><script src="sistema.js"></script></body></html>