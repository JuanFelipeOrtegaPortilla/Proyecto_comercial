<%@ Page Language="C#" AutoEventWireup="true" MasterPageFile="~/Sitio.Master" CodeBehind="PlanCuentas.aspx.cs" Inherits="CooperativaCarchi.PlanCuentas" %>
<asp:Content ID="Principal" ContentPlaceHolderID="Contenido" runat="server"><h1>Plan de cuentas</h1><asp:Label ID="Mensaje" runat="server" role="status" CssClass="mensaje"/><section><div class="fields"><div class="field"><asp:Label runat="server" AssociatedControlID="IdRegistro" Text="ID"/><asp:TextBox ID="IdRegistro" runat="server" MaxLength="250" ReadOnly="true"/></div><div class="field"><asp:Label runat="server" AssociatedControlID="EmpresaLista" Text="Empresa"/><asp:DropDownList ID="EmpresaLista" runat="server" AutoPostBack="true" OnSelectedIndexChanged="CambiarEmpresa"></asp:DropDownList></div><div class="field"><asp:Label runat="server" AssociatedControlID="Codigo" Text="Código"/><asp:TextBox ID="Codigo" runat="server" MaxLength="250"/></div><div class="field"><asp:Label runat="server" AssociatedControlID="NombreCuenta" Text="Nombre"/><asp:TextBox ID="NombreCuenta" runat="server" MaxLength="250"/></div><div class="field"><asp:Label runat="server" AssociatedControlID="Grupo" Text="Grupo contable"/><asp:DropDownList ID="Grupo" runat="server"><asp:ListItem Value="1">Activo</asp:ListItem><asp:ListItem Value="2">Pasivo</asp:ListItem><asp:ListItem Value="3">Patrimonio</asp:ListItem><asp:ListItem Value="4">Ingresos</asp:ListItem><asp:ListItem Value="5">Gastos</asp:ListItem><asp:ListItem Value="6">Cuentas transitorias</asp:ListItem></asp:DropDownList></div><div class="field"><asp:Label runat="server" AssociatedControlID="Padre" Text="Código de cuenta padre"/><asp:TextBox ID="Padre" runat="server" MaxLength="250"/></div><div class="field"><asp:Label runat="server" AssociatedControlID="Nivel" Text="Nivel (calculado)"/><asp:TextBox ID="Nivel" runat="server" MaxLength="250" ReadOnly="true"/></div><div class="field"><asp:Label runat="server" AssociatedControlID="GrupoExcel" Text="Clasificación Excel"/><asp:DropDownList ID="GrupoExcel" runat="server"><asp:ListItem Value="">Sin clasificación</asp:ListItem><asp:ListItem Value="AC">AC</asp:ListItem><asp:ListItem Value="ANC">ANC</asp:ListItem><asp:ListItem Value="PC">PC</asp:ListItem><asp:ListItem Value="PNC">PNC</asp:ListItem><asp:ListItem Value="PAT">PAT</asp:ListItem><asp:ListItem Value="ING">ING</asp:ListItem><asp:ListItem Value="GAD">GAD</asp:ListItem><asp:ListItem Value="GVE">GVE</asp:ListItem><asp:ListItem Value="GFI">GFI</asp:ListItem><asp:ListItem Value="COS">COS</asp:ListItem><asp:ListItem Value="TRA">TRA</asp:ListItem></asp:DropDownList></div><div class="field"><asp:Label runat="server" AssociatedControlID="Naturaleza" Text="Naturaleza"/><asp:DropDownList ID="Naturaleza" runat="server"><asp:ListItem Value="Deudora">Deudora</asp:ListItem><asp:ListItem Value="Acreedora">Acreedora</asp:ListItem></asp:DropDownList></div><div class="field"><asp:Label runat="server" AssociatedControlID="Tipo" Text="Tipo"/><asp:DropDownList ID="Tipo" runat="server"><asp:ListItem Value="Grupo">Grupo</asp:ListItem><asp:ListItem Value="Movimiento">Movimiento</asp:ListItem></asp:DropDownList></div><div class="field"><asp:Label runat="server" AssociatedControlID="Debe" Text="Debe inicial"/><asp:TextBox ID="Debe" runat="server" MaxLength="250"/></div><div class="field"><asp:Label runat="server" AssociatedControlID="Haber" Text="Haber inicial"/><asp:TextBox ID="Haber" runat="server" MaxLength="250"/></div><div class="field"><asp:Label runat="server" AssociatedControlID="Activo" Text="Activa"/><asp:CheckBox ID="Activo" runat="server" Checked="true"/></div></div><div class="actions"><asp:Button ID="Nuevo" runat="server" Text="Nuevo" OnClick="Limpiar"/><asp:Button ID="Guardar" runat="server" Text="Guardar" OnClick="GuardarRegistro"/><asp:Button ID="Actualizar" runat="server" Text="Actualizar" OnClick="ActualizarRegistro"/><asp:Button ID="Eliminar" runat="server" Text="Eliminar" OnClick="EliminarRegistro" OnClientClick="return confirm('¿Eliminar el registro seleccionado?');" CssClass="danger"/><asp:Button ID="LimpiarBoton" runat="server" Text="Limpiar" OnClick="Limpiar"/></div></section><p class="nota">Importes con punto decimal, sin separadores de miles. AC / ANC equivale a Activo; PC / PNC equivale a Pasivo; PAT equivale a Patrimonio; ING equivale a Ingresos; GAD / GVE / GFI / COS equivale a Gastos; TRA equivale a Transitorias. Catálogo cotejado: 91 cuentas del PDF; 44 cuentas operativas con saldos del Excel. No se importan asientos.</p><section><div class="actions"><asp:DropDownList ID="FiltroGrupo" runat="server"><asp:ListItem Value="0">Todos los grupos</asp:ListItem><asp:ListItem Value="1">Activo</asp:ListItem><asp:ListItem Value="2">Pasivo</asp:ListItem><asp:ListItem Value="3">Patrimonio</asp:ListItem><asp:ListItem Value="4">Ingresos</asp:ListItem><asp:ListItem Value="5">Gastos</asp:ListItem><asp:ListItem Value="6">Cuentas transitorias</asp:ListItem></asp:DropDownList><asp:TextBox ID="Buscar" runat="server" placeholder="Buscar" aria-label="Buscar registros"/><asp:Button ID="BuscarBoton" runat="server" Text="Buscar" OnClick="BuscarRegistros"/></div><div class="tabla-wrap"><asp:GridView ID="Tabla" runat="server" AutoGenerateColumns="false" DataKeyNames="Id" OnSelectedIndexChanged="SeleccionarRegistro" CssClass="tabla" GridLines="None" EmptyDataText="No hay registros."><Columns><asp:CommandField ShowSelectButton="true" SelectText="Seleccionar"/><asp:BoundField DataField="Id" HeaderText="ID"/><asp:BoundField DataField="Codigo" HeaderText="Código"/><asp:BoundField DataField="Nombre" HeaderText="Nombre"/><asp:BoundField DataField="Grupo" HeaderText="Grupo"/><asp:BoundField DataField="CuentaPadre" HeaderText="Padre"/><asp:BoundField DataField="Nivel" HeaderText="Nivel"/><asp:BoundField DataField="GrupoExcel" HeaderText="Excel"/><asp:BoundField DataField="Naturaleza" HeaderText="Naturaleza"/><asp:BoundField DataField="Tipo" HeaderText="Tipo"/><asp:BoundField DataField="DebeInicial" HeaderText="Debe inicial" DataFormatString="{0:N2}"/><asp:BoundField DataField="HaberInicial" HeaderText="Haber inicial" DataFormatString="{0:N2}"/><asp:BoundField DataField="Activa" HeaderText="Activa"/></Columns></asp:GridView></div></section></asp:Content>